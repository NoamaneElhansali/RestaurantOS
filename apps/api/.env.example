APP_NAME=RestaurantOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=Africa/Casablanca
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=restaurantos
DB_USERNAME=restaurantos
DB_PASSWORD=local-dev-only-change-me
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@restaurantos.test
MAIL_FROM_NAME=RestaurantOS
# Real delivery: use MAIL_MAILER=smtp and configure MAIL_HOST, MAIL_PORT,
# MAIL_USERNAME and MAIL_PASSWORD privately. Never commit SMTP credentials.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000
FRONTEND_ORIGINS=http://localhost:5173
